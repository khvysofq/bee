# 数据库：唯一必填项。换库只改这行。
DATABASE_URL=postgresql://bee:CHANGE_ME@127.0.0.1:5432/bee

RAW_STORE_DIR=./data/raw-store
NEXT_PUBLIC_SITE_NAME=报废品行情信息平台

# 采集作业（P0）：worker → /internal/ingest 的 service token。
# 缺失时 /internal/ingest 返回 503，绝不放行无鉴权写入。
INGEST_TOKEN=CHANGE_ME
INGEST_URL=http://127.0.0.1:10800

# 对象存储（原始存档，P2 起使用）
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=bee
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 缓存/限流（问答用）
REDIS_URL=redis://127.0.0.1:6379/0

# 行业问答（/qa）的叙事模型：OpenAI 兼容接口，三项都填了才会启用。
# 留空 = 确定性回答（知识库检索 + 报价库数字 + 模板叙事），这是默认且完整可用的形态。
# 只认下面这几个 QA_LLM_* 变量：应用不读取运行环境里任何其他服务的密钥。
# 凭据由部署方通过 secret 流程注入，本文件只放占位，任何情况下都不要写真实值。
QA_LLM_API_KEY=
QA_LLM_BASE_URL=
QA_LLM_MODEL=
# 可选：单次叙事请求超时（毫秒），默认 8000，上限 60000。
QA_LLM_TIMEOUT_MS=8000
